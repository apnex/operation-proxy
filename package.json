{
  "name": "@apnex/operation-proxy",
  "version": "0.0.0",
  "private": true,
  "description": "Let short-lived processes invoke named operations through one long-lived caller they share, each invocation still ending honestly.",
  "license": "MIT",
  "author": "apnex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apnex/operation-proxy.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./machine": {
      "types": "./dist/machine.d.ts",
      "default": "./dist/machine.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "npm run build && npm run test:types && node --test \"test/**/*.test.js\"",
    "test:types": "tsc -p test/types",
    "docs:check": "tools/check-docs.sh"
  },
  "devDependencies": {
    "@agp/core": "file:../agp/packages/core",
    "@agp/node": "file:../agp/packages/node",
    "@agp/transport-loopback": "file:../agp/packages/transport-loopback",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@apnex/operation-call": "file:../operation-call",
    "@apnex/shape-check": "file:../shape-check"
  }
}
